# HackMate backend configuration. Copy to backend/.env and fill in real values.
# Never commit backend/.env (it is git-ignored). Every value below is a placeholder.

# --- General ---------------------------------------------------------------
# development | test | production. Production enforces secure settings at startup.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Interactive API docs at /docs. Defaults to on outside production.
# ENABLE_DOCS=true

# --- Database: MongoDB Atlas --------------------------------------------------
# Atlas: Database > Connect > Drivers > copy the "mongodb+srv://" string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=hackmate
MONGODB_TIMEOUT_MS=5000

# Local development without Atlas: an in-memory MongoDB emulation (mongomock).
# Data is kept in IN_MEMORY_DB_SNAPSHOT between restarts. Refused in production.
USE_IN_MEMORY_DB=false
IN_MEMORY_DB_SNAPSHOT=.local-db.json
# Load the clearly labelled demo dataset at startup if it is missing (development only).
SEED_DEMO_DATA_ON_STARTUP=false
# Optional password for the demo accounts (*.demo@example.com). Leave empty to make
# them impossible to sign into. Never set this for a shared or production database.
SEED_DEMO_PASSWORD=

# --- Sessions -------------------------------------------------------------------
# REQUIRED in production: at least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_TTL_HOURS=168
# Cookies: COOKIE_SECURE defaults to true in production. Keep SameSite=lax when the
# frontend proxies /api (Vite dev proxy or the Vercel rewrite). Use "none" only for
# cross-site deployments (requires HTTPS; see docs/DEPLOYMENT.md).
# COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
REQUIRE_EMAIL_VERIFICATION=false

# --- CORS and links ---------------------------------------------------------------
# Comma-separated list of exact frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used to build links in emails (verification, password reset).
FRONTEND_URL=http://localhost:5173

# --- Email (optional). Leave SMTP_HOST empty to disable delivery. ------------------
# Without SMTP, nothing is sent; in development the link is printed to this server's
# console (never returned by the API).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=HackMate <no-reply@your-domain.example>
SMTP_STARTTLS=true
SMTP_SSL=false

# --- Rate limiting ------------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# --- Opportunity data providers ---------------------------------------------------
EXTERNAL_PROVIDERS_ENABLED=true
# Contact address sent to OpenAlex/Crossref so they can reach you about your traffic.
CONTACT_EMAIL=
# Free key from https://openalex.org/settings/api (10x the keyless daily budget).
OPENALEX_API_KEY=
# Optional GitHub token (no scopes needed) to raise search rate limits.
GITHUB_TOKEN=
# Comma-separated organizer JSON feeds (format: docs/OPPORTUNITY_SOURCES.md).
HACKATHON_FEED_URLS=
PROVIDER_TIMEOUT_SECONDS=8
PROVIDER_CACHE_TTL_SECONDS=600
