# Copy to .env.local for local overrides. Never put secrets here: every VITE_*
# variable is compiled into the public JavaScript bundle.

# Where the browser sends API requests.
# - Local dev: keep "/api" (Vite proxies it to VITE_DEV_PROXY_TARGET).
# - Vercel with the rewrite in vercel.json: keep "/api" (recommended, first-party cookies).
# - Cross-site mode: the full backend URL, e.g. https://hackmate-api.onrender.com/api
#   (requires COOKIE_SAMESITE=none on the backend; see docs/DEPLOYMENT.md).
VITE_API_BASE_URL=/api

# Dev server only: where Vite forwards /api requests.
VITE_DEV_PROXY_TARGET=http://localhost:8000
